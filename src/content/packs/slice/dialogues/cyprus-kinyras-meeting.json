              }
            }
          ],
          "next": "seal",
          "id": "show-him-the-seal",
          "intent": "help"
        }
      ]
    },
    "again": {
      "text": "\"You again. The ingots have not learned to weigh less.\" He does not put the board down, which is as close as he comes to an invitation. \"Say your business. The boy is expensive and the light is going.\"",
      "choices": [
        {
          "text": "What is copper worth today?",
          "next": "offer",
          "id": "what-is-copper-worth",
          "intent": "probe"
        },
        {
          "text": "Does the yard buy grain?",
          "next": "grain",
          "id": "does-the-yard-buy",
          "intent": "probe"
        },
        {
          "text": "Show him the seal and say nothing.",
          "conditions": {
            "all": [
              {
                "itemAtLeast": {
