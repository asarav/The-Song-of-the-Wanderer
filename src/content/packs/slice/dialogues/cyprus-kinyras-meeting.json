  "nodes": {
    "greet": {
      "text": "He has a board under one arm and a piece of charcoal in the other hand, and he is counting ingots in a stack that has already been counted. A boy stands at his elbow with a tally stick and the expression of someone who has been hit for correcting him.\n\n\"You have the smell of the mainland on you. Ugarit?\" He does not look up. \"Do not tell me the crossing was good. Nobody's crossing is good, and I am not in the mood to be lied to before lunch.\"",
      "choices": [
        {
          "text": "Ugarit.",
          "effects": [
            {
              "flag": "kinyras.met"
            },
            {
              "relationship": {
                "character": "char.cyprus.kinyras",
                "dimension": "trust",
                "delta": 1
              }
            }
          ],
          "next": "offer",
          "id": "ugarit",
          "intent": "help"
        },
        {
          "text": "Does it matter?",
          "effects": [
            {
              "flag": "kinyras.met"
            },
            {
              "relationship": {
                "character": "char.cyprus.kinyras",
                "dimension": "respect",
                "delta": 1
              }
            }
          ],
          "next": "offer",
          "id": "does-it-matter",
          "intent": "help"
        },
        {
          "text": "Show him the seal and say nothing.",
          "conditions": {
            "all": [
              {
                "itemAtLeast": {
                  "item": "good.palace-seal",
                  "quantity": 1
                }
              },
              {
                "not": {
