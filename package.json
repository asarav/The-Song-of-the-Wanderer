{
  "name": "song-of-the-wanderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "description": "The Song of the Wanderer - a narrative historical travel RPG set in the Late Bronze Age.",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:lint": "tsx tools/content-lint.ts",
    "audio:build": "node tools/build-audio.mjs",
    "audio:check": "node tools/check-audio.mjs",
    "simulate": "tsx tools/simulate.ts",
    "playtest:build": "tsx tools/playtest.ts",
    "save:inspect": "tsx tools/save-inspect.ts",
    "save:migrate": "tsx tools/save-migrate.ts",
    "skills:sync": "node tools/sync-skills.mjs",
    "skills:check": "node tools/sync-skills.mjs --check",
    "agents:sync": "node tools/sync-skills.mjs",
    "check": "node tools/check.mjs",
    "playtest:review": "tsx tools/playtest-review.ts",
    "migrate:model": "tsx tools/migrate-model.ts",
    "model:check": "tsx tools/model-check.ts",
    "prose:lint": "tsx tools/prose-lint.ts",
    "price:check": "tsx tools/price-check.ts",
    "content:guard": "tsx tools/content-guard.ts",
    "invariant:check": "tsx tools/invariant-check.ts",
    "migrate:scenarios": "tsx tools/migrate-scenarios.ts",
    "ask": "tsx tools/ask.ts",
    "entity": "tsx tools/entity.ts",
    "flag": "tsx tools/flag.ts",
    "impact": "tsx tools/impact.ts",
    "task:brief": "tsx tools/task-brief.ts",
    "content:workbench": "tsx tools/workbench.ts",
    "scene:preview": "tsx tools/scene-preview.ts",
    "manuscript": "tsx tools/manuscript.ts",
    "coverage:choices": "tsx tools/coverage-choices.ts",
    "affected": "tsx tools/affected.ts",
    "docs:sync": "tsx tools/docs-sync.ts",
    "docs:check": "tsx tools/docs-check.ts",
    "new:dialogue": "tsx tools/new-dialogue.ts",
    "art:ledger": "tsx tools/art-ledger.ts",
    "task:finish": "tsx tools/task-finish.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
